  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var data = pm.response.json();",
                  "if (data.token) {",
                  "  pm.collectionVariables.set('authToken', data.token.replace(/^Bearer\\s+/i, ''));",
                  "}",
                  "if (data.id) {",
                  "  pm.collectionVariables.set('usuarioId', String(data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"maria@email.com\",\n  \"senha\": \"12345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios/logar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios",
                "logar"
              ]
            }
          },
          "response": []
        }
      ]
    },
