    "description": "Collection Postman para testar as rotas da API AP Koukan em ambiente de desenvolvimento.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": "1"
    },
    {
      "key": "artistaId",
      "value": "1"
